{
  "name": "ryans-road-to-the-lpga",
  "private": true,
  "version": "0.20.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build:single": "tsc --noEmit && SINGLE=1 vite build",
    "build:site": "tsc --noEmit && vite build --outDir dist-site/play --emptyOutDir && node scripts/build-site.mjs",
    "preview:site": "npx --yes serve dist-site -l 4173",
    "lore:export": "npx --yes vite-node scripts/export-sports-lore.ts"
  },
  "dependencies": {
    "@fontsource/jersey-15": "^5.3.0",
    "@fontsource/tiny5": "^5.3.0",
    "dexie": "^4.4.7",
    "phaser": "^4.2.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "fake-indexeddb": "^6.2.8",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.1.1"
  }
}
