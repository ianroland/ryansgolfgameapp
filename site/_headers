# Read by Cloudflare Pages and Netlify.
# Game code and art have content hashes in their names: cache them for a year.
/play/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Pages and dev notes: always check for a newer version.
/*.html
  Cache-Control: no-cache
/
  Cache-Control: no-cache
/play/
  Cache-Control: no-cache
/devnotes.json
  Cache-Control: no-cache

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
