{
  "$id": "sports-lore/2/history/playoff_series.json",
  "title": "sports-lore/2 history/playoff_series.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "minLength": 1
      },
      "league": {
        "type": "string",
        "enum": [
          "gdc",
          "ccl",
          "igl",
          "fhl"
        ]
      },
      "year": {
        "type": "integer",
        "minimum": 1900,
        "maximum": 2200
      },
      "round": {
        "type": "string",
        "enum": [
          "semifinal",
          "final"
        ]
      },
      "high_seed": {
        "type": "string",
        "pattern": "^(gdc|ccl|igl|fhl)_[a-z_]+$"
      },
      "low_seed": {
        "type": "string",
        "pattern": "^(gdc|ccl|igl|fhl)_[a-z_]+$"
      },
      "seeds": {
        "type": "array",
        "prefixItems": [
          {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          }
        ],
        "items": false,
        "minItems": 2,
        "maxItems": 2
      },
      "winner": {
        "type": "string",
        "pattern": "^(gdc|ccl|igl|fhl)_[a-z_]+$"
      },
      "loser": {
        "type": "string",
        "pattern": "^(gdc|ccl|igl|fhl)_[a-z_]+$"
      },
      "wins": {
        "type": "object",
        "propertyNames": {
          "type": "string"
        },
        "additionalProperties": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        }
      },
      "games": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "comeback": {
        "type": [
          "string",
          "null"
        ]
      },
      "legendary": {
        "type": "boolean"
      },
      "provenance": {
        "type": "string",
        "enum": [
          "approved_canon",
          "proposed_canon",
          "derived_statistic",
          "generated_history"
        ]
      }
    },
    "required": [
      "id",
      "league",
      "year",
      "round",
      "high_seed",
      "low_seed",
      "seeds",
      "winner",
      "loser",
      "wins",
      "games",
      "comeback",
      "legendary",
      "provenance"
    ],
    "additionalProperties": false
  }
}
