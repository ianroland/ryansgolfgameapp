      "dialogue": {
        "intro": [
          {
            "id": "dp_server.intro.1",
            "speaker": "dp_server",
            "expression": "friendly",
            "text": "Welcome back to Desert Palms. Want your usual, Ryan?"
          },
          {
            "id": "dp_server.intro.2",
            "speaker": "dp_server",
            "expression": "friendly",
            "text": "You found my section again. Lucky me."
          }
        ],
        "order": [
          {
            "id": "dp_server.order.1",
            "speaker": "dp_server",
            "expression": "friendly",
            "text": "One Tito’s Double. Coming right up."
          },
          {
            "id": "dp_server.order.2",
            "speaker": "dp_server",
            "expression": "friendly",
            "text": "The usual? I could have guessed."
          }
        ],
        "first_order": [
          {
            "id": "dp_server.first_order.1",
            "speaker": "dp_server",
            "expression": "friendly",
            "text": "Tito’s Double? I’ll remember that."
          }
        ],
        "chat": [
          {
            "id": "dp_server.chat.1",
            "speaker": "dp_server",
            "expression": "playful",
            "text": "How’s the golf treating you?"
          },
          {
            "id": "dp_server.chat.2",
            "speaker": "dp_server",
            "expression": "playful",
            "text": "The night shift hears everything. Almost everything."
          }
        ],
        "tip": [
          {
            "id": "dp_server.tip.1",
            "speaker": "dp_server",
            "expression": "impressed",
            "text": "Thank you, Ryan. That was thoughtful."
          },
          {
            "id": "dp_server.tip.2",
            "speaker": "dp_server",
            "expression": "impressed",
            "text": "You didn’t have to, but I appreciate it."
          }
        ],
        "no_tip": [
          {
            "id": "dp_server.no_tip.1",
            "speaker": "dp_server",
            "expression": "friendly",
            "text": "No problem. Enjoy your game."
          }
        ],
        "decline": [
          {
            "id": "dp_server.decline.1",
            "speaker": "dp_server",
            "expression": "friendly",
            "text": "All good. I’ll check back later."
          }
        ],
        "water": [
          {
            "id": "dp_server.water.1",
            "speaker": "dp_server",
            "expression": "friendly",
            "text": "Water it is. Good call."
          }
        ],
        "rumor": [
          {
            "id": "dp_server.rumor.1",
            "speaker": "dp_server",
            "expression": "impressed",
            "text": "There’s a card game people only mention after midnight. That’s all I’m saying."
          }
        ],
        "concern": [
          {
            "id": "dp_server.concern.1",
            "speaker": "dp_server",
            "expression": "concerned",
            "text": "Hey, I’m keeping an eye on you. How about water this round?"
          }
        ],
        "refusal": [
          {
            "id": "dp_server.refusal.1",
            "speaker": "dp_server",
            "expression": "firm",
            "text": "No more Tito’s tonight, Ryan. Water’s on me."
          },
          {
            "id": "dp_server.refusal.2",
            "speaker": "dp_server",
            "expression": "firm",
            "text": "I’m not serving another double. Let’s get you some water."
          }
        ],
        "hostile": [
          {
            "id": "dp_server.hostile.1",
            "speaker": "dp_server",
            "expression": "annoyed",
            "text": "I’m here to do my job, Ryan. Let’s keep it respectful."
          }
        ],
        "apology": [
          {
            "id": "dp_server.apology.1",
            "speaker": "dp_server",
            "expression": "friendly",
            "text": "Thanks for saying that. Let’s start fresh."
          }
        ],
        "farewell": [
          {
            "id": "dp_server.farewell.1",
            "speaker": "dp_server",
            "expression": "friendly",
            "text": "See you next time. And good luck out there."
          }
        ]
      }
    },
