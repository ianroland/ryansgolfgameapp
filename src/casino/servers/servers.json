        "refusal": [
          {
            "id": "wb_server.refusal.1",
            "speaker": "wb_server",
            "expression": "firm",
            "text": "I’m cutting you off for tonight, Ryan. Water is available."
          },
          {
            "id": "wb_server.refusal.2",
            "speaker": "wb_server",
            "expression": "firm",
            "text": "No more doubles. We can talk, but I’m not pouring another."
