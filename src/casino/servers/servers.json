      "dialogue": {
        "intro": [
          {
            "id": "ms_server.intro.1",
            "speaker": "ms_server",
            "expression": "friendly",
            "text": "Good evening, Ryan. Shall I bring your usual?"
          },
          {
            "id": "ms_server.intro.2",
            "speaker": "ms_server",
            "expression": "friendly",
            "text": "Welcome to Morongo Sky. I hope your evening is going well."
          }
        ],
        "order": [
          {
            "id": "ms_server.order.1",
            "speaker": "ms_server",
            "expression": "friendly",
            "text": "A Tito’s Double. Certainly."
          },
          {
            "id": "ms_server.order.2",
            "speaker": "ms_server",
            "expression": "friendly",
            "text": "Your usual. I’ll have it brought over."
          }
        ],
        "first_order": [
          {
            "id": "ms_server.first_order.1",
            "speaker": "ms_server",
            "expression": "friendly",
            "text": "A Tito’s Double. I’ll remember your preference."
          }
        ],
        "chat": [
          {
            "id": "ms_server.chat.1",
            "speaker": "ms_server",
            "expression": "playful",
            "text": "Discretion is a valuable currency here."
          },
          {
            "id": "ms_server.chat.2",
            "speaker": "ms_server",
            "expression": "playful",
            "text": "Not every invitation arrives in an envelope."
          }
        ],
        "tip": [
          {
            "id": "ms_server.tip.1",
            "speaker": "ms_server",
            "expression": "impressed",
            "text": "Very kind of you. Thank you."
          },
          {
            "id": "ms_server.tip.2",
            "speaker": "ms_server",
            "expression": "impressed",
            "text": "I appreciate your consideration."
          }
        ],
        "no_tip": [
          {
            "id": "ms_server.no_tip.1",
            "speaker": "ms_server",
            "expression": "friendly",
            "text": "Of course. Enjoy your evening."
          }
        ],
        "decline": [
          {
            "id": "ms_server.decline.1",
            "speaker": "ms_server",
            "expression": "friendly",
            "text": "As you wish."
          }
        ],
        "water": [
          {
            "id": "ms_server.water.1",
            "speaker": "ms_server",
            "expression": "friendly",
            "text": "Water, certainly."
          }
        ],
        "rumor": [
          {
            "id": "ms_server.rumor.1",
            "speaker": "ms_server",
            "expression": "impressed",
            "text": "There is a private table upstairs. Invitations are not requested; they are offered."
          }
        ],
        "concern": [
          {
            "id": "ms_server.concern.1",
            "speaker": "ms_server",
            "expression": "concerned",
            "text": "Ryan, may I suggest water for now?"
          }
        ],
        "refusal": [
          {
            "id": "ms_server.refusal.1",
            "speaker": "ms_server",
            "expression": "firm",
            "text": "I won’t be serving another alcoholic drink tonight. I can offer water."
          },
          {
            "id": "ms_server.refusal.2",
            "speaker": "ms_server",
            "expression": "firm",
            "text": "For your well-being, service of alcohol is finished for the evening."
