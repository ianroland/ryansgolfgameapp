      "dialogue": {
        "intro": [
          {
            "id": "wb_server.intro.1",
            "speaker": "wb_server",
            "expression": "friendly",
            "text": "Evening, Ryan. The usual, or are we taking it easy?"
          },
          {
            "id": "wb_server.intro.2",
            "speaker": "wb_server",
            "expression": "friendly",
            "text": "I saw you walk in. You looked like you had a story."
          }
        ],
        "order": [
          {
            "id": "wb_server.order.1",
            "speaker": "wb_server",
            "expression": "friendly",
            "text": "Tito’s Double. Understood."
          },
          {
            "id": "wb_server.order.2",
            "speaker": "wb_server",
            "expression": "friendly",
            "text": "One double. I’ll be back."
          }
        ],
        "first_order": [
          {
            "id": "wb_server.first_order.1",
            "speaker": "wb_server",
            "expression": "friendly",
            "text": "A Tito’s Double. Noted."
          }
        ],
        "chat": [
          {
            "id": "wb_server.chat.1",
            "speaker": "wb_server",
            "expression": "playful",
            "text": "The tables aren’t the only place people make decisions."
          },
          {
            "id": "wb_server.chat.2",
            "speaker": "wb_server",
            "expression": "playful",
            "text": "You’d be surprised what a quiet room can tell you."
          }
        ],
        "tip": [
          {
            "id": "wb_server.tip.1",
            "speaker": "wb_server",
            "expression": "impressed",
            "text": "Much appreciated."
          },
          {
            "id": "wb_server.tip.2",
            "speaker": "wb_server",
            "expression": "impressed",
            "text": "That’s generous. Thank you."
          }
        ],
        "no_tip": [
          {
            "id": "wb_server.no_tip.1",
            "speaker": "wb_server",
            "expression": "friendly",
            "text": "No worries."
          }
        ],
        "decline": [
          {
            "id": "wb_server.decline.1",
            "speaker": "wb_server",
            "expression": "friendly",
            "text": "Fair enough."
          }
        ],
        "water": [
          {
            "id": "wb_server.water.1",
            "speaker": "wb_server",
            "expression": "friendly",
            "text": "Water. Smart choice."
          }
        ],
        "rumor": [
          {
            "id": "wb_server.rumor.1",
            "speaker": "wb_server",
            "expression": "impressed",
            "text": "Some regulars meet away from the main floor. They’re selective about company."
